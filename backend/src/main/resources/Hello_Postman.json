{
  "name": "TourPlanner Hello Postman",
  "item": [
    {
      "name": "Hello Postman",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/hello",
          "host": [
            "http://localhost:8080"
          ],
          "path": [
            "api",
            "hello"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains hello text\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql(\"hello world\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}